{
  "name": "gongkao-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "prepare:mobile": "node scripts/prepare-mobile-assets.js",
    "import:fenbi": "python scripts/import_fenbi_question_bank.py && npm run prepare:mobile",
    "build:mobile": "npm run prepare:mobile && set MOBILE_EXPORT=1&& next build",
    "android:sync": "npm run build:mobile && npx cap sync android",
    "ios:sync": "npm run build:mobile && npx cap sync ios",
    "apk:debug": "npm run build:mobile && npx cap sync android && cd android && gradlew assembleDebug",
    "check:site": "powershell -ExecutionPolicy Bypass -File scripts/check-site-health.ps1",
    "audit:questions": "node scripts/audit-question-bank.js",
    "test": "node scripts/verify-store.mjs && node scripts/verify-client-store.mjs",
    "test:pg": "node scripts/verify-store-pg.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:import-json": "node scripts/migrate-json-to-pg.mjs",
    "smoke:api": "node scripts/smoke-api.mjs",
    "smoke:answers": "node scripts/smoke-answers.mjs"
  },
  "dependencies": {
    "next": "^14.2.0",
    "pg": "^8.13.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@types/node": "^20",
    "@types/pg": "^8.11.0",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/three": "^0.184.1",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5"
  }
}
