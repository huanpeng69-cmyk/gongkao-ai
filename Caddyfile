# Caddy 反向代理 + 自动 HTTPS。
#
# 站点地址来自环境变量 GONGKAO_DOMAIN，必须设置：
#   生产：GONGKAO_DOMAIN=app.example.com
#         → 自动申请并续期 Let's Encrypt 证书；要求该域名已解析到本机，
#           且公网 80/443 可达（80 用于 ACME 校验与 HTTP→HTTPS 跳转）。
#   本地：GONGKAO_DOMAIN=localhost
#         → Caddy 用内部 CA 签发自签证书（浏览器会告警，curl 加 -k）。
#
# 若未设置 GONGKAO_DOMAIN，站点地址为空，Caddy 会直接报错退出。
# 这是刻意的 fail-loud：避免「容器起来了但证书签给了错误域名」这类静默错误。

{$GONGKAO_DOMAIN} {
	# 压缩静态资源与 JSON 响应。
	encode zstd gzip

	# 转发到应用容器：compose 网络内按服务名解析，无需暴露端口。
	# Caddy 默认会带上 X-Forwarded-For / X-Forwarded-Proto: https，
	# 后者是将来「按协议决定 Cookie secure」的基础。
	reverse_proxy gongkao-ai:3000

	# 访问日志输出到容器 stderr，便于 docker compose logs 查看。
	log {
		output stderr
		format console
	}
}
