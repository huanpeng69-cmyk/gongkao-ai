PORT=3000
EMBED_PUBLIC_AI_KEYS=0

# Agnes AI unified provider configuration.
# Create the key in Agnes AI and keep it server-side for hosted web deployments.
AGNES_API_KEY=
AI_TEXT_MODEL=gpt-4.1-mini
AI_IMAGE_MODEL=agnes-image-2.1-flash
AI_IMAGE_SIZE=1K
AI_IMAGE_RATIO=1:1

# Optional modality-specific Agnes keys. Normally leave these empty and use AGNES_API_KEY.
AI_TEXT_API_KEY=
AI_IMAGE_API_KEY=

# EMBED_PUBLIC_AI_KEYS=1 injects AGNES_API_KEY into a private mobile build.
# Never enable it for a public website or a distributable APK.
