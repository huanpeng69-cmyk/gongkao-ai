PORT=3000
GONGKAO_DATA_DIR=./data/server

# 存储驱动：json（默认，单实例 users.json）| pg（PostgreSQL）
STORAGE_DRIVER=json
# STORAGE_DRIVER=pg 时必填；docker compose 内置库示例：
# DATABASE_URL=postgres://gongkao:change-me@localhost:5433/gongkao
DATABASE_URL=
# 仅 npm run test:pg 使用，库名须含 test，测试会清空其中的表
TEST_DATABASE_URL=
EMBED_PUBLIC_AI_KEYS=0

# Agnes AI text-generation configuration.
AGNES_API_KEY=
AI_TEXT_MODEL=agnes-2.0-flash
AI_TEXT_API_KEY=

# WisArt official OpenAI-compatible image-generation interface.
IMAGE_BASE_URL=https://wisart.kuaileshifu.com
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-2
IMAGE_AUTH_SCHEME=bearer
IMAGE_SIZE=1200x675

# EMBED_PUBLIC_AI_KEYS=1 embeds keys in a private mobile build.
# Never enable it for a public website or a distributable APK.
