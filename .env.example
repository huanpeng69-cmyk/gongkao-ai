PORT=3000
EMBED_PUBLIC_AI_KEYS=0

# Agnes AI text-generation configuration.
AGNES_API_KEY=
AI_TEXT_MODEL=agnes-2.0-flash
AI_TEXT_API_KEY=

# WisArt official OpenAI-compatible image-generation interface.
IMAGE_BASE_URL=https://wisart.kuaileshifu.com
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-2
IMAGE_AUTH_SCHEME=bearer
IMAGE_SIZE=1200x675

# EMBED_PUBLIC_AI_KEYS=1 embeds keys in a private mobile build.
# Never enable it for a public website or a distributable APK.
